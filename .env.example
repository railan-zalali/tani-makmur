# Database MySQL (cPanel)
DB_HOST=localhost
DB_USER=nama_user_db_cpanel
DB_PASSWORD=password_db_cpanel
DB_NAME=nama_database_cpanel

# PIN untuk admin panel (ganti dengan PIN Anda sendiri)
ADMIN_PIN=12345

# Supabase (untuk data produk dan upload gambar produk)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Server-only. Pakai service role key agar admin bisa upload ke Supabase Storage.
# Jangan pakai prefix NEXT_PUBLIC untuk key ini.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx
